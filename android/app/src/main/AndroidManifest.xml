<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet access for WebSocket connection -->
    <uses-permission android:name="android.permission.INTERNET" />
<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground service to keep connection alive in background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Request exemption from battery optimization (Doze mode) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Clay"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- singleTask: returning to the app (launcher icon, notification tap, recents) must
             reuse the running instance and deliver onNewIntent, not build a fresh one. Under the
             default "standard" mode the notification's FLAG_ACTIVITY_CLEAR_TOP destroyed and
             recreated this Activity every time, which is what made a switch-back look like a
             cold start.
             configChanges: the app owns a live session and a WebView, so an environment change
             must not recreate the Activity. orientation/screenSize/keyboard were already
             handled; uiMode (dark-mode toggle), density, fontScale, screenLayout,
             smallestScreenSize, locale, layoutDirection and navigation were not. -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground service for background connection -->
        <service
            android:name=".ClayForegroundService"
            android:foregroundServiceType="remoteMessaging"
            android:exported="false" />

    </application>

</manifest>
